# Copy to .env. scripts/configure.py generates a unique SECRET_KEY.
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=AeroFlow
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=
# Local Express demonstration. Use a trusted TLS certificate and yes/no in production.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SESSION_COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000
