# Copy to .env. scripts/configure.py generates a unique SECRET_KEY.
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
SQL_SERVER=.\SQLEXPRESS
SQL_DATABASE=AeroFlow
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=
# Local Express demonstration. Use a trusted TLS certificate and yes/no in production.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SESSION_COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5000
# Cookie riêng khi chạy song song bản cũ / nhiều bản demo.
SESSION_COOKIE_NAME=aeroflow_ultimate
# Mặc định Windows dùng C:/Windows/Fonts/arial.ttf; tùy chọn đường dẫn TTF Unicode.
PDF_FONT_PATH=

# Optional operator-run notifications. STARTTLS; web requests never send email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
